{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Lightweight social UI system for Connect, balancing X-style density, Threads-style conversation, Instagram media polish, and Discord-like presence.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.145,
          0.388,
          0.922
        ],
        "hex": "#2563eb"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.392,
          0.455,
          0.545
        ],
        "hex": "#64748b"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.486,
          0.227,
          0.929
        ],
        "hex": "#7c3aed"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.933,
          0.949,
          0.969
        ],
        "hex": "#eef2f7"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "on-surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.059,
          0.09,
          0.165
        ],
        "hex": "#0f172a"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.58,
          0.639,
          0.722
        ],
        "hex": "#94a3b8"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.059,
          0.09,
          0.165
        ],
        "hex": "#0f172a14"
      }
    },
    "error": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.863,
          0.149,
          0.149
        ],
        "hex": "#dc2626"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.086,
          0.396,
          0.204
        ],
        "hex": "#166534"
      }
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.573,
          0.251,
          0.055
        ],
        "hex": "#92400e"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xxl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "headline-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Noto Sans JP",
        "fontSize": {
          "value": 28,
          "unit": "px"
        },
        "fontWeight": 800,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "headline-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Noto Sans JP",
        "fontSize": {
          "value": 22,
          "unit": "px"
        },
        "fontWeight": 800,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Noto Sans JP",
        "fontSize": {
          "value": 16,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Noto Sans JP",
        "fontSize": {
          "value": 14,
          "unit": "px"
        },
        "fontWeight": 500,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "label-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Noto Sans JP",
        "fontSize": {
          "value": 13,
          "unit": "px"
        },
        "fontWeight": 800,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  }
}
