rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Moderation privileges come only from a Firebase custom claim signed into
    // the ID token. Client-side visibility is only a navigation convenience.
    function isAdmin() {
      return isAuth() && request.auth.token.role == 'admin';
    }

    // Helper: check if the authenticated user is the document owner
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Helper: check if the authenticated user is the document owner based on a field
    function isFieldOwner(field) {
      return isAuth() && request.auth.uid == resource.data[field];
    }

    // Keep this list in parity with the server/client ActiveNotificationType
    // allowlist. Legacy and unknown notifications remain readable in Phase A
    // only for compatibility, but cannot be mutated as active notifications.
    function isActiveNotificationType(type) {
      return type is string && type in [
        'like', 'comment', 'reply', 'mention', 'repost',
        'friend_request', 'friend_accept', 'friend_story', 'story_reaction', 'post_moderated'
      ];
    }

    function isAdminPostModerationUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin()
        && changed.hasOnly([
          'text', 'body', 'content', 'imageURLs', 'imageURL', 'imageAlts',
          'attachments', 'videoURL', 'gifURL', 'audioURL', 'fileURL',
          'poll', 'quotedPost', 'quotedPostSnapshot', 'moderationStatus',
          'deletedAt', 'deleteReason', 'deletedBy', 'updatedAt'
        ])
        && (
          ('moderationStatus' in request.resource.data
            && request.resource.data.moderationStatus == 'removed'
            && request.resource.data.deletedAt is timestamp
            && request.resource.data.deleteReason in ['spam', 'harassment', 'illegal', 'other'])
          || (resource.data.moderationStatus == 'removed'
            && !('moderationStatus' in request.resource.data)
            && !('deletedAt' in request.resource.data))
        );
    }

    function preservesPostModerationFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'moderationStatus', 'deletedAt', 'deleteReason', 'deletedBy'
      ]);
    }

    function isAdminModerationNotification() {
      let post = get(/databases/$(database)/documents/posts/$(request.resource.data.postId));
      return isAdmin()
        && request.resource.data.type == 'post_moderated'
        && request.resource.data.postId is string
        && request.resource.data.userId is string
        && request.resource.data.eventId is string
        && request.resource.data.deepLink is string
        && post.data.userId == request.resource.data.userId
        && post.data.deletedAt is timestamp
        && post.data.moderationStatus == 'removed';
    }

    function isPostMetricUpdate() {
      return isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likesCount',
          'commentsCount',
          'repostsCount',
          'viewCount',
          'profileClickCount'
        ])
        && (!('likesCount' in request.resource.data) || request.resource.data.likesCount is int)
        && (!('commentsCount' in request.resource.data) || request.resource.data.commentsCount is int)
        && (!('repostsCount' in request.resource.data) || request.resource.data.repostsCount is int)
        && (!('viewCount' in request.resource.data) || request.resource.data.viewCount is int)
        && (!('profileClickCount' in request.resource.data) || request.resource.data.profileClickCount is int);
    }


    function isPostPollVoteUpdate() {
      return isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll'])
        && resource.data.poll is map
        && request.resource.data.poll is map
        && request.resource.data.poll.totalVotes == resource.data.poll.totalVotes + 1;
    }

    // Comment bodies are editable only by the immutable document owner.
    // Keep this distinct from the legacy likes counter path so an ordinary
    // authenticated user cannot turn a metric write into a content edit.
    function isCommentContentUpdate() {
      return isFieldOwner('userId')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentions', 'editedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.mentions is list;
    }

    function isCommentLikeMetricUpdate() {
      return isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
        && request.resource.data.likesCount is int
        && request.resource.data.likesCount >= 0;
    }

    // New post writes use the same 1000-code-point product limit as the
    // client. A legacy long post may still receive non-text updates, but its
    // existing body must remain byte-for-byte unchanged. This avoids breaking
    // old documents while preventing new oversized bodies through direct SDK
    // writes.
    function hasSafePostText() {
      return !('text' in request.resource.data)
        || (request.resource.data.text is string && request.resource.data.text.size() <= 1000);
    }

    function preservesLegacyLongPostText() {
      return resource.data.text is string
        && resource.data.text.size() > 1000
        && request.resource.data.text == resource.data.text;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if (isAuth() && hasSafePostText()) || isAdmin();
      allow update: if isAdminPostModerationUpdate() || (
        isFieldOwner('userId')
        && !('deletedAt' in resource.data)
        && preservesPostModerationFields()
        && (hasSafePostText() || preservesLegacyLongPostText())
      ) || isPostMetricUpdate() || isPostPollVoteUpdate();
      allow delete: if isFieldOwner('userId') && !('deletedAt' in resource.data);
    }

    match /postViews/{viewId} {
      allow read: if false;
      allow create: if isAuth()
        && request.resource.data.postId is string
        && (!('viewerId' in request.resource.data) || request.resource.data.viewerId == request.auth.uid);
      allow update, delete: if false;
    }

    match /postProfileClicks/{clickId} {
      allow read: if false;
      allow create: if isAuth()
        && request.resource.data.postId is string
        && (!('viewerId' in request.resource.data) || request.resource.data.viewerId == request.auth.uid);
      allow update, delete: if false;
    }

    // Comments collection
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isCommentContentUpdate() || isCommentLikeMetricUpdate();
      allow delete: if isFieldOwner('userId');
    }

    // Comment likes collection
    match /commentLikes/{likeId} {
      allow read: if true;
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.commentId is string;
      allow delete: if isFieldOwner('userId');
      allow update: if false;
    }

    // Likes collection
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isAuth()
        && (
          (request.resource.data.get('type', '') == 'comment'
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.commentId is string
            && likeId == 'comment_' + request.resource.data.commentId + '_' + request.auth.uid
            && request.resource.data.eventId == likeId
            && request.resource.data.keys().hasOnly(['type', 'commentId', 'userId', 'eventId', 'createdAt']))
          || (request.resource.data.get('type', '') != 'comment'
            && !('commentId' in request.resource.data))
        );
      allow delete: if isFieldOwner('userId');
      allow update: if false;
    }

    // Friendships collection
    // 閲覧は全認証ユーザーに許可（プロフィール画面で他ユーザーの友達一覧を表示するため）
    // 作成・更新・削除は参加者のみ
    match /friendships/{friendshipId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.requester == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.requester == request.auth.uid
        || resource.data.friendId == request.auth.uid
      );
      allow delete: if isAuth() && (
        resource.data.requester == request.auth.uid
        || resource.data.friendId == request.auth.uid
      );
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isFieldOwner('userId');
      // Notification documents are server-authoritative. The authenticated
      // API/Functions runtime creates them after source validation; clients
      // may only update the recipient's read state.
      allow create: if isAdminModerationNotification();
      allow update: if isFieldOwner('userId')
        && isActiveNotificationType(resource.data.type)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isFieldOwner('userId');
    }

    // Server-only Web Push records. Client access is provided through authenticated Vercel APIs.
    match /pushSubscriptions/{subscriptionId} {
      allow read, write: if false;
    }

    match /pushDispatches/{dispatchId} {
      allow read, write: if false;
    }

    match /pushDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    match /pushDeliveryDeadLetters/{deadLetterId} {
      allow read, write: if false;
    }

    match /pushSubscriptionRateLimits/{userId} {
      allow read, write: if false;
    }

    // Search projection is derived server data. Firebase Admin SDK access is
    // intentionally outside Rules; every client get/list/query/write must be
    // rejected here. Do not rely on a more-specific deny to override a broad
    // allow elsewhere: this file has no recursive fallback allow for this path.
    match /postSearchIndex/{postId} {
      allow read, write: if false;
    }

    // Stories collection
    match /stories/{storyId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.authorId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'reactionCount'])
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll'])
          && resource.data.poll is map
          && request.resource.data.poll is map
          && request.resource.data.poll.totalVotes == resource.data.poll.totalVotes + 1
        )
      );
      allow delete: if false;

      match /views/{viewerId} {
        allow read: if isAuth() && (
          viewerId == request.auth.uid
          || get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid
        );
        allow create: if isAuth()
          && viewerId == request.auth.uid
          && request.resource.data.viewerId == request.auth.uid
          && request.resource.data.storyId == storyId;
        allow update, delete: if false;
      }
    }

    // Story views
    match /storyViews/{viewId} {
      allow read: if isAuth() && (
        resource.data.viewerId == request.auth.uid
        || resource.data.authorId == request.auth.uid
        || get(/databases/$(database)/documents/stories/$(resource.data.storyId)).data.authorId == request.auth.uid
      );
      allow create: if isAuth()
        && request.resource.data.viewerId == request.auth.uid
        && request.resource.data.storyId is string;
      allow update, delete: if false;
    }

    // Story reactions
    match /storyReactions/{reactionId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.storyId is string;
      allow update, delete: if false;
    }

    // Reposts collection
    match /bookmarks/{bmId} {
      // get must also work before the bookmark document exists; list remains scoped to the owner.
      allow get: if isAuth() && bmId.matches(request.auth.uid + '_.*');
      allow list: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId is string
        && bmId == request.auth.uid + '_' + request.resource.data.postId;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // Hashtags collection
    match /hashtags/{tag} {
      allow read: if true;
      // H1: client aggregate writes are stopped after the server-side writer
      // inventory. Existing aggregate documents are retained for compatibility.
      allow write: if false;
    }

    // Reposts collection
    match /reposts/{repostId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // Conversations collection
    match /conversations/{convId} {
      // Phase A: preserve the existing authenticated read predicate for
      // historical best-effort reads, while stopping every new mutation.
      allow read: if isAuth();
      allow create, update: if false;
      allow delete: if false;
    }

    // Messages subcollection
    // update: any auth user can mark messages as read (add readBy)
    match /conversations/{convId}/messages/{msgId} {
      // Phase A historical read only. The previous read predicate is kept
      // exactly; create/update/delete are disabled immediately.
      allow read: if isAuth();
      allow create, update: if false;
      allow delete: if false;
    }

    // WebRTC calls and ICE candidates. Only conversation participants can signal.
    match /conversations/{convId}/calls/{callId} {
      allow read, write: if false;

      match /candidates/{candidateId} {
        allow read, write: if false;
      }
    }

    // Typing status subcollection
    match /conversations/{convId}/typing/{typingId} {
      allow read, write: if false;
    }


    // Seed flag
    match /_seed/{docId} {
      allow read: if true;
      allow write: if isAuth();
    }
  }
}
