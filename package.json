{
  "name": "connect-sns",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:vercel": "vite build --config vite.config.vercel-connect.ts",
    "build:vercel-legacy": "vite build --config vite.config.legacy.ts",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:check": "wrangler d1 execute connect-social --local --command \"SELECT name FROM sqlite_schema ORDER BY name\"",
    "ai:production:check": "node scripts/verify-production-ai-config.mjs",
    "cf:standalone:deploy": "npm run ai:production:check && wrangler deploy --config wrangler.standalone.jsonc",
    "cf:standalone:migrate:list": "wrangler d1 migrations list connect-social --remote --config wrangler.standalone.jsonc",
    "cf:standalone:migrate:apply": "wrangler d1 migrations apply connect-social --remote --config wrangler.standalone.jsonc",
    "migration:export": "tsx scripts/migrate-firestore-to-d1.ts --export-only",
    "migration:import": "tsx scripts/migrate-firestore-to-d1.ts",
    "migration:verify": "tsx scripts/verify-connect-integrity.ts",
    "media:optimize": "tsx scripts/optimize-r2-media.ts",
    "ai:predeploy": "tsx scripts/predeploy-ai-check.ts",
    "perf:production": "tsx scripts/measure-production.ts",
    "admin:cleanup-demo-users": "node scripts/cleanup-demo-users.mjs",
    "admin:backfill-user-search-fields": "node scripts/backfill-user-search-fields.mjs",
    "admin:backfill-post-search-index": "node scripts/backfill-post-search-index.mjs",
    "admin:preflight-search": "node scripts/preflight-search.mjs",
    "admin:build-search-prototype": "node scripts/build-search-prototype.mjs",
    "admin:benchmark-search-prototype": "node scripts/benchmark-search-prototype.mjs",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:prebuild": "npm --prefix mobile run prebuild",
    "design:lint": "designmd lint DESIGN.md",
    "design:export": "designmd export DESIGN.md --format dtcg > design.tokens.json",
    "design:check": "npm run design:lint && npm run design:export",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.legacy.json --noEmit",
    "typecheck:legacy": "tsc -p tsconfig.legacy.json --noEmit",
    "lint": "eslint src/react worker db tests",
    "test": "vitest run"
  },
  "dependencies": {
    "better-auth": "1.6.24",
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
    ,"zod": "4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.0",
    "@cloudflare/workers-types": "5.20260820.1",
    "@google/design.md": "^0.3.0",
    "@openai/sites-vite-plugin": "0.2.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vercel/functions": "^3.9.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "firebase": "^10.14.0",
    "firebase-admin": "^13.5.0",
    "jose": "^6.2.3",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "web-push": "^3.6.7",
    "wrangler": "4.124.0"
  }
}
