rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /dm/{userId}/{allPaths=**} {
      // Phase A: retain the current effective read behavior for historical
      // attachments, but stop all new DM objects immediately. Phase B will
      // change this read to false after the independent audit window.
      allow read: if true;
      allow write: if false;
    }
    match /comments/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 3 * 1024 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*|audio/.*|application/.*|text/.*');
    }
    match /posts/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (
          (request.resource.contentType.matches('video/.*')
            && request.resource.size <= 3 * 1024 * 1024 * 1024)
          || (request.resource.contentType.matches('image/.*')
            && request.resource.size <= 15 * 1024 * 1024)
        )
        && request.resource.contentType.matches('image/.*|video/.*');
    }
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (
          (request.resource.contentType.matches('video/.*')
            && request.resource.size <= 3 * 1024 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/.*')
            && request.resource.size <= 15 * 1024 * 1024)
          || (!request.resource.contentType.matches('video/.*')
            && request.resource.size < 10 * 1024 * 1024)
        )
        && request.resource.contentType.matches('image/.*|video/.*|audio/.*|application/.*|text/.*');
    }
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('image/.*|video/.*|audio/.*|application/.*|text/.*');
    }
    match /stories/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('image/.*|video/.*|audio/.*|application/.*|text/.*');
    }
  }
}
